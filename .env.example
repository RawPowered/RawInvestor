# Copy to project root; never commit real values.
PORT=3001

# Optional eBay application credentials (sold comps API). Admin UI can also store these in portfolio meta.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Production loopback API auth (Electron generates stable values in userData when unset).
PCGR_APP_TOKEN=
PCGR_EXT_TOKEN=
PCGR_MAINT_TOKEN=

# Optional comma-separated CORS origins beyond extension + Electron (production hardened mode).
PCGR_ALLOWED_ORIGINS=

# Runtime data directories (defaults: server/data, server/images under repo or userData when packaged).
# PCGR_DATA_DIR=
# PCGR_IMAGES_DIR=
# PCGR_BACKUPS_DIR=
# PCGR_UPLOADS_DIR=

# Dev only: allow API without tokens when NODE_ENV is not production.
# PCGR_ALLOW_INSECURE_DEV_AUTH=1
